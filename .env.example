# ─────────────────────────────────────────────────────────────
#  Green Gibb — Variables de entorno
#  Copia este archivo como `.env.local` y completa los valores.
#  Nunca subas `.env.local` al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio — SOLO para tareas de servidor / migraciones.
# Nunca la expongas en el cliente (no lleva prefijo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (sin slash final). Ej: https://greengibb.mx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp en formato internacional sin "+", espacios ni guiones.
# Ej: 528112345678  (52 = México, 81 = Monterrey)
NEXT_PUBLIC_WHATSAPP_NUMBER=528100000000

# Meta Pixel (opcional — el sitio funciona sin él)
NEXT_PUBLIC_META_PIXEL_ID=
